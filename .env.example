# Enable shared illustrative accounts only for local development.
# NEVER enable demo access on a publicly deployed production service.
DEMO_MODE=1
PORT=3000
HOST=0.0.0.0
# DB_PATH=.data/voqro.sqlite
# Set COOKIE_SECURE=1 behind HTTPS.

# Optional private media location; back up alongside the database.
# UPLOAD_PATH=/workspace/voqro/.data/uploads
# Local processing uses ffprobe installed on PATH.

# Production uses a separate, empty persistent database and HTTPS origin.
# DEMO_MODE=0
# APP_BASE_URL=https://your-app.example
# DB_PATH=/var/lib/voqro/production.sqlite
# UPLOAD_PATH=/var/lib/voqro/uploads
# COOKIE_SECURE=1
# Vercel website build only: public HTTPS address of the persistent backend.
# VOQRO_BACKEND_ORIGIN=https://api.your-domain.example
# Optional Vercel CSP allowance when direct S3 uploads are enabled on the backend:
# VOQRO_S3_UPLOAD_ORIGIN=https://your-media-bucket.s3.ap-south-1.amazonaws.com
# APP_BASE_URL above is the public Vercel/custom website origin, not the backend origin.
# Keep database, identity, and integration secrets on the backend host.
# COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_YOURPOOL
# COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
# COGNITO_DOMAIN=https://YOURDOMAIN.auth.ap-south-1.amazoncognito.com
# IDENTITY_BOOTSTRAP_EMAIL=your-verified-owner@example.com

# Optional AWS adapters. All live capabilities remain disabled unless enabled.
# Credentials come from the deployment IAM identity, never this example file.
# AWS_REGION=ap-south-1
# AWS_MEDIA_ENABLED=0
# AWS_MEDIA_BUCKET=your-private-versioned-bucket
# AWS_AI_ENABLED=0
# BEDROCK_MODEL_ID=your-explicitly-approved-model-id
# AWS_AI_PRICING_VERIFIED=0
# AWS_AI_JOB_RESERVATION_CENTS=50
# AWS_AI_MONTHLY_LIMIT_CENTS=500

# Meta requires its verified API version, account permissions and exact callback.
# META_APP_ID=
# META_GRAPH_VERSION=
# META_REDIRECT_URI=https://your-app.example/api/instagram/oauth/callback
# INSTAGRAM_PUBLISH_ENABLED=0
# Supply META_APP_SECRET and INTEGRATION_TOKEN_KEY through secure runtime
# configuration. Do not commit values or paste them into chat. See docs/instagram.md.

# SES transactional outbox: verified production recipients only, explicit opt-in.
# NOTIFICATION_EMAIL_ENABLED=0
# SES_FROM_EMAIL=notifications@your-domain.example
# SES_VERIFIED_IDENTITY=your-domain.example
# SES_CONFIGURATION_SET=
# EMAIL_DAILY_LIMIT=25
# EMAIL_MONTHLY_LIMIT=200
