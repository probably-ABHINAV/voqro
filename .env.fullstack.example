# Copy to .env.fullstack for local development. Never commit the real file.
# This database stays separate from the older shared demonstration database.
AUTH_PROVIDER=password
DEMO_MODE=0
APP_BASE_URL=http://127.0.0.1:3100
AUTH_ALLOW_INSECURE_LOCAL=1
WEB_PORT=3100
BACKEND_PORT=3101
DB_PATH=.data/fullstack/voqro.sqlite
UPLOAD_PATH=.data/fullstack/uploads
IDENTITY_BOOTSTRAP_EMAIL=
# Generate a strong random setup key; use it once on /setup to create the owner.
IDENTITY_BOOTSTRAP_SECRET=
AWS_MEDIA_ENABLED=0
AWS_AI_ENABLED=0
INSTAGRAM_PUBLISH_ENABLED=0
NOTIFICATION_EMAIL_ENABLED=0
